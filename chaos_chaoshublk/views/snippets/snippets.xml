<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ChaosHub.lk Website Builder Snippets -->
    <!-- Register custom snippets for drag-and-drop in Website Builder -->

    <template id="chaoshub_snippets" inherit_id="website.snippets" priority="16">
        <!-- Add ChaosHub Snippet Category -->
        <xpath expr="//div[@id='snippet_structure']/div[@class='o_panel_body']" position="inside">
            <t id="chaoshub_snippets_category">
                <div class="o_panel_header">
                    ChaosHub Components
                </div>
            </t>
        </xpath>

        <!-- Hero Section Snippet -->
        <xpath expr="//t[@id='chaoshub_snippets_category']" position="after">
            <t t-snippet="chaos_chaoshublk.s_chaoshub_hero"
               t-thumbnail="/chaos_chaoshublk/static/src/img/snippets/s_hero_thumb.svg"
               string="ChaosHub Hero"/>
        </xpath>

        <!-- Features Grid Snippet -->
        <xpath expr="//t[@id='chaoshub_snippets_category']" position="after">
            <t t-snippet="chaos_chaoshublk.s_chaoshub_features"
               t-thumbnail="/chaos_chaoshublk/static/src/img/snippets/s_features_thumb.svg"
               string="Features Grid"/>
        </xpath>

        <!-- Blog Cards Snippet -->
        <xpath expr="//t[@id='chaoshub_snippets_category']" position="after">
            <t t-snippet="chaos_chaoshublk.s_chaoshub_blog_cards"
               t-thumbnail="/chaos_chaoshublk/static/src/img/snippets/s_blog_cards_thumb.svg"
               string="Blog Cards"/>
        </xpath>

        <!-- CTA Banner Snippet -->
        <xpath expr="//t[@id='chaoshub_snippets_category']" position="after">
            <t t-snippet="chaos_chaoshublk.s_chaoshub_cta"
               t-thumbnail="/chaos_chaoshublk/static/src/img/snippets/s_cta_thumb.svg"
               string="CTA Banner"/>
        </xpath>

        <!-- Newsletter Snippet -->
        <xpath expr="//t[@id='chaoshub_snippets_category']" position="after">
            <t t-snippet="chaos_chaoshublk.s_chaoshub_newsletter"
               t-thumbnail="/chaos_chaoshublk/static/src/img/snippets/s_newsletter_thumb.svg"
               string="Newsletter Subscription"/>
        </xpath>
    </template>
</odoo>
