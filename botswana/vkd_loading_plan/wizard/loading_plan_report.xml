<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loading_plan_report_view_form" model="ir.ui.view">
        <field name="name">loading.plan.report.form</field>
        <field name="model">loading.plan.report</field>
        <field name="arch" type="xml">
            <form string="Generate Loading Plan Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="supplier_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Download Excel" type="object" class="oe_highlight" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_loading_plan_report" model="ir.actions.act_window">
        <field name="name">Loading Plan Excel Report</field>
        <field name="res_model">loading.plan.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>