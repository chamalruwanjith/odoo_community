<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions for Reports -->
    
    <!-- Partner Ledger Currency Action -->
    <record id="action_partner_ledger_currency" model="ir.actions.client">
        <field name="name">Partner Ledger (Currency Wise)</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('partner_ledger_currency_report')}"/>
    </record>
    
    <!-- Aged Receivable Currency Action -->
    <record id="action_aged_receivable_currency" model="ir.actions.client">
        <field name="name">Aged Receivable (Currency Wise)</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('aged_receivable_currency_report')}"/>
    </record>

    <!-- Aged Payable Currency Action -->
    <record id="action_aged_payable_currency" model="ir.actions.client">
        <field name="name">Aged Payable (Currency Wise)</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('aged_payable_currency_report')}"/>
    </record>
    
    <!-- Menu Items -->
    
    <!-- Main Menu for Currency Reports -->
    <menuitem id="menu_currency_reports"
              name="Currency Reports"
              parent="account.menu_finance_reports"
              sequence="100"
              groups="account.group_account_readonly"/>

    <!-- Partner Ledger Currency Menu -->
    <menuitem id="menu_partner_ledger_currency"
              name="Partner Ledger (Currency Wise)"
              action="action_partner_ledger_currency"
              parent="menu_currency_reports"
              sequence="1"
              groups="account.group_account_readonly"/>

    <!-- Aged Receivable Currency Menu -->
    <menuitem id="menu_aged_receivable_currency"
              name="Aged Receivable (Currency Wise)"
              action="action_aged_receivable_currency"
              parent="menu_currency_reports"
              sequence="2"
              groups="account.group_account_readonly"/>

    <!-- Aged Payable Currency Menu -->
    <menuitem id="menu_aged_payable_currency"
              name="Aged Payable (Currency Wise)"
              action="action_aged_payable_currency"
              parent="menu_currency_reports"
              sequence="3"
              groups="account.group_account_readonly"/>
</odoo>
