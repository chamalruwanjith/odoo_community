<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_trailer_view_form" model="ir.ui.view">
        <field name="name">fleet.trailer.view.form</field>
        <field name="model">fleet.trailer</field>
        <field name="arch" type="xml">
            <form string="Trailer">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Tanker A1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="license_plate"/>
                            <field name="vin_sn"/>
                            <field name="trailer_type"/>
                        </group>
                        <group string="Specifications">
                            <field name="capacity"/>
                            <field name="vehicle_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes about this trailer..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fleet_trailer_view_list" model="ir.ui.view">
        <field name="name">fleet.trailer.list</field>
        <field name="model">fleet.trailer</field>
        <field name="arch" type="xml">
            <list string="Trailers">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="trailer_type"/>
                <field name="capacity"/>
                <field name="vehicle_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="fleet_trailer_view_search" model="ir.ui.view">
        <field name="name">fleet.trailer.view.search</field>
        <field name="model">fleet.trailer</field>
        <field name="arch" type="xml">
            <search string="Search Trailers">
                <field name="name" string="Trailer" filter_domain="['|', ('name', 'ilike', self), ('license_plate', 'ilike', self)]"/>
                <field name="license_plate"/>
                <field name="vehicle_id"/>
                <separator/>
                <filter string="Linked to Vehicle" name="linked" domain="[('vehicle_id', '!=', False)]"/>
                <filter string="Not Linked" name="not_linked" domain="[('vehicle_id', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'trailer_type'}"/>
                    <filter string="Linked Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_trailer_action" model="ir.actions.act_window">
        <field name="name">Trailers</field>
        <field name="res_model">fleet.trailer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new trailer
            </p>
            <p>
                Manage your fleet trailers here. You can link trailers to vehicles for transport operations.
            </p>
        </field>
    </record>
</odoo>
