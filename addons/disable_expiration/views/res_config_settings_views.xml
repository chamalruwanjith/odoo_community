<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Social Media Configuration to Settings -->
    <record id="view_general_configuration_inherit_social" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.disable.expiration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Social Media (No Subscription)" string="Social Media Configuration" data-key="disable_expiration">
                    <h2>Social Media OAuth Configuration (Bypass IAP)</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Configure Social Media APIs</span>
                                <div class="text-muted">
                                    Use your own OAuth credentials instead of Odoo IAP subscriptions
                                </div>
                                <div class="content-group mt16">
                                    <div class="row">
                                        <label class="col-lg-3 o_light_label" string="Facebook App ID"/>
                                        <field name="social_facebook_app_id" placeholder="Your Facebook App ID"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-3 o_light_label" string="Facebook Secret"/>
                                        <field name="social_facebook_client_secret" password="True" placeholder="Your Facebook App Secret"/>
                                    </div>
                                    <div class="row mt8">
                                        <label class="col-lg-3 o_light_label" string="LinkedIn Client ID"/>
                                        <field name="social_linkedin_client_id" placeholder="Your LinkedIn Client ID"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-3 o_light_label" string="LinkedIn Secret"/>
                                        <field name="social_linkedin_client_secret" password="True" placeholder="Your LinkedIn Client Secret"/>
                                    </div>
                                    <div class="row mt8">
                                        <label class="col-lg-3 o_light_label" string="Twitter API Key"/>
                                        <field name="social_twitter_consumer_key" placeholder="Your Twitter Consumer Key"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-3 o_light_label" string="Twitter API Secret"/>
                                        <field name="social_twitter_consumer_secret" password="True" placeholder="Your Twitter Consumer Secret"/>
                                    </div>
                                    <div class="row mt8">
                                        <label class="col-lg-3 o_light_label" string="YouTube Client ID"/>
                                        <field name="social_youtube_client_id" placeholder="Your YouTube Client ID"/>
                                    </div>
                                    <div class="row">
                                        <label class="col-lg-3 o_light_label" string="YouTube Secret"/>
                                        <field name="social_youtube_client_secret" password="True" placeholder="Your YouTube Client Secret"/>
                                    </div>
                                </div>
                                <div class="alert alert-info mt16" role="alert">
                                    <h5>Where to get OAuth credentials:</h5>
                                    <ul>
                                        <li><strong>Facebook/Instagram:</strong> <a href="https://developers.facebook.com/apps" target="_blank">developers.facebook.com/apps</a></li>
                                        <li><strong>LinkedIn:</strong> <a href="https://www.linkedin.com/developers/apps" target="_blank">linkedin.com/developers/apps</a></li>
                                        <li><strong>Twitter:</strong> <a href="https://developer.twitter.com/apps" target="_blank">developer.twitter.com/apps</a></li>
                                        <li><strong>YouTube:</strong> <a href="https://console.cloud.google.com/" target="_blank">console.cloud.google.com</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
