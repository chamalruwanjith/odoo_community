<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhance Blog Post Page with SEO -->
    <template id="blog_post_seo_enhance" name="Blog Post SEO Enhancement" inherit_id="website_blog.blog_post_complete">
        <xpath expr="//head" position="inside">
            <!-- JSON-LD Structured Data for Blog Post -->
            <t t-set="post" t-value="blog_post"/>
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "<t t-esc="post.schema_type or 'Article'"/>",
                "headline": "<t t-esc="post.name"/>",
                "description": "<t t-esc="post.subtitle or (post.teaser[:160] if post.teaser else '')"/>",
                "image": "<t t-if="post.cover_properties" t-esc="website.image_url(post, 'cover_properties')"/>",
                "datePublished": "<t t-if="post.create_date" t-esc="post.create_date.isoformat()"/>",
                "dateModified": "<t t-if="post.write_date" t-esc="post.write_date.isoformat()"/>",
                "author": {
                    "@type": "Person",
                    "name": "<t t-esc="post.author_id.name if post.author_id else 'ChaosHub Team'"/>"
                },
                "publisher": {
                    "@type": "Organization",
                    "name": "ChaosHub.lk",
                    "url": "https://chaoshub.lk"
                },
                "wordCount": <t t-esc="len(post.content.split()) if post.content else 0"/>,
                "timeRequired": "PT<t t-esc="post.reading_time"/>M"
            }
            </script>
        </xpath>

        <!-- Add Reading Time to Post Header -->
        <xpath expr="//div[@id='blog_content']//div[@class='o_blog_post_header']" position="inside">
            <div class="o_blog_post_meta" t-if="blog_post.reading_time">
                <i class="fa fa-clock-o"/> <t t-esc="blog_post.reading_time"/> min read
            </div>
        </xpath>
    </template>
</odoo>
