<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_fuel_supplier" model="ir.ui.view">
        <field name="name">res.partner.form.fuel.supplier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group name="fuel_supplier" string="Fuel Supplier Information">
                    <field name="fuel_supplier_type"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
