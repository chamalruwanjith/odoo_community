<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- News/Blog Landing Page Template -->
        <template id="news_page" name="News & Insights">
            <t t-call="website.layout">
                <t t-set="pageName" t-value="'news'"/>

                <div id="wrap" class="o_chaoshub_website">
                    <!-- Hero Section -->
                    <section class="hero" style="min-height: 60vh;">
                        <div class="container">
                            <div class="hero-content">
                                <span class="hero-badge">Knowledge Hub</span>
                                <h1>Latest News &amp; Insights</h1>
                                <p class="hero-subtext">
                                    Stay updated with the latest articles, guides, tutorials, and industry insights from ChaosHub.
                                </p>
                            </div>
                        </div>
                    </section>

                    <!-- Blog Categories Section -->
                    <section class="section">
                        <div class="container">
                            <div class="section-header">
                                <span class="section-badge">Browse by Topic</span>
                                <h2 class="section-title">Explore Content Categories</h2>
                            </div>

                            <div class="grid grid-4">
                                <a href="/blog" class="card knowledge-card" style="text-decoration: none; color: inherit;">
                                    <div class="card-icon">📊</div>
                                    <h3 class="card-title">ERP &amp; Business</h3>
                                    <p class="card-text">
                                        ERP systems, business management, and process optimization.
                                    </p>
                                </a>

                                <a href="/blog" class="card knowledge-card" style="text-decoration: none; color: inherit;">
                                    <div class="card-icon">💰</div>
                                    <h3 class="card-title">Accounting &amp; Finance</h3>
                                    <p class="card-text">
                                        Financial management, accounting tips, and compliance guides.
                                    </p>
                                </a>

                                <a href="/blog" class="card knowledge-card" style="text-decoration: none; color: inherit;">
                                    <div class="card-icon">🔄</div>
                                    <h3 class="card-title">Digital Transformation</h3>
                                    <p class="card-text">
                                        Modern strategies, cloud solutions, and tech trends.
                                    </p>
                                </a>

                                <a href="/blog" class="card knowledge-card" style="text-decoration: none; color: inherit;">
                                    <div class="card-icon">⚙️</div>
                                    <h3 class="card-title">Odoo Tutorials</h3>
                                    <p class="card-text">
                                        Step-by-step guides and best practices for Odoo.
                                    </p>
                                </a>
                            </div>
                        </div>
                    </section>

                    <!-- Featured Articles Placeholder -->
                    <section class="section section-alt">
                        <div class="container">
                            <div class="section-header">
                                <span class="section-badge">Latest Posts</span>
                                <h2 class="section-title">Recent Articles</h2>
                                <p class="section-description">
                                    Discover our most recent guides, tutorials, and case studies.
                                </p>
                            </div>

                            <div class="grid grid-3">
                                <!-- Article 1 - Placeholder -->
                                <article class="article-card">
                                    <div class="article-image">📚</div>
                                    <div class="article-content">
                                        <div class="article-meta">
                                            <span class="article-tag">ERP</span>
                                            <span>5 min read</span>
                                        </div>
                                        <h3 class="article-title">Understanding ERP Systems for Small Businesses</h3>
                                        <p class="article-excerpt">
                                            Learn ERP fundamentals and best practices to streamline your business operations.
                                        </p>
                                        <a href="/blog" class="article-link">Read More →</a>
                                    </div>
                                </article>

                                <!-- Article 2 - Placeholder -->
                                <article class="article-card">
                                    <div class="article-image">🚀</div>
                                    <div class="article-content">
                                        <div class="article-meta">
                                            <span class="article-tag">Digital</span>
                                            <span>7 min read</span>
                                        </div>
                                        <h3 class="article-title">Top 5 Digital Transformation Tips for Enterprises</h3>
                                        <p class="article-excerpt">
                                            Modern strategies for growth in the digital era and how to implement them.
                                        </p>
                                        <a href="/blog" class="article-link">Read More →</a>
                                    </div>
                                </article>

                                <!-- Article 3 - Placeholder -->
                                <article class="article-card">
                                    <div class="article-image">💡</div>
                                    <div class="article-content">
                                        <div class="article-meta">
                                            <span class="article-tag">Odoo</span>
                                            <span>6 min read</span>
                                        </div>
                                        <h3 class="article-title">Streamline Accounting with Odoo</h3>
                                        <p class="article-excerpt">
                                            Practical guides for efficiency and automation in your accounting workflows.
                                        </p>
                                        <a href="/blog" class="article-link">Read More →</a>
                                    </div>
                                </article>
                            </div>

                            <div class="text-center mt-8">
                                <a href="/blog" class="btn btn-primary btn-lg">View All Articles →</a>
                            </div>
                        </div>
                    </section>

                    <!-- Newsletter CTA -->
                    <section class="section">
                        <div class="container">
                            <div class="cta-banner">
                                <div class="cta-content">
                                    <h2>Never Miss an Update</h2>
                                    <p>
                                        Subscribe to our newsletter and get the latest insights delivered straight to your inbox.
                                    </p>
                                    <form class="newsletter-form" action="/website/form/subscribe" method="POST" style="max-width: 500px; margin: 0 auto;">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input
                                            type="email"
                                            class="newsletter-input"
                                            placeholder="Enter your email"
                                            required="required"
                                            name="email"
                                            style="min-width: 100%;"
                                        />
                                        <button type="submit" class="btn btn-primary" style="width: 100%;">Subscribe Now</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <!-- Page Record -->
        <record id="news_page_record" model="website.page">
            <field name="name">News &amp; Insights</field>
            <field name="is_published" eval="True"/>
            <field name="url">/news</field>
            <field name="view_id" ref="news_page"/>
            <field name="track" eval="True"/>
        </record>
    </data>
</odoo>
