<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.vkd_fuel_transporter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_transporter_bill" string="Create Transporter Bill" type="object" context="{'create_bill':True}"
                        invisible="state not in ('posted')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transporter_bills" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="transporter_bill_count == 0">
                    <field name="transporter_bill_count" widget="statinfo" string="Transporter Bills"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Transporter Information">
                    <group>
                        <field name="transporter_id"/>
                        <field name="transporter_vehicle_id"/>
                        <field name="location_rate"/>
                    </group>
                    <group string="Trailers">
                        <field name="trailer_1_id"/>
                        <field name="trailer_2_id"/>
                        <field name="trailer_3_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit.vkd_fuel_transporter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="transporter_id" optional="hide"/>
                <field name="transporter_vehicle_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.view.search.inherit.vkd_fuel_transporter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="transporter_id"/>
                <field name="transporter_vehicle_id"/>
                <filter string="Has Transporter" name="has_transporter" domain="[('transporter_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Transporter" name="group_transporter" context="{'group_by': 'transporter_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
