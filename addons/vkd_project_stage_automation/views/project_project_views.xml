<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Project Form View -->
    <record id="project_project_view_form_inherit_automation" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.automation</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- Load fields for smart buttons -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="stage_automation_count" invisible="1"/>
                <field name="project_stage_automation_count" invisible="1"/>
            </xpath>

            <!-- Add smart button for task automation rules -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_stage_automation_rules"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-magic"
                        invisible="stage_automation_count == 0">
                    <field name="stage_automation_count" widget="statinfo"
                           string="Task Automation"/>
                </button>
                <button name="action_view_project_stage_automation_rules"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sitemap"
                        invisible="project_stage_automation_count == 0">
                    <field name="project_stage_automation_count" widget="statinfo"
                           string="Project Automation"/>
                </button>
            </xpath>

            <!-- Add Stage Automation page in notebook -->
            <xpath expr="//notebook" position="inside">
                <page name="stage_automation" string="Stage Automation" groups="project.group_project_manager">
                    <field name="has_stage_automation" invisible="1"/>

                    <group>
                        <group>
                            <label for="stage_automation_ids" string="Automation Rules"/>
                        </group>
                    </group>

                    <field name="stage_automation_ids" context="{'default_project_id': id}">
                        <tree editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="project_id" column_invisible="1"/>
                            <field name="name" required="1"/>
                            <field name="trigger_stage_id"
                                   options="{'no_create': True}"/>
                            <field name="condition_type"/>
                            <field name="condition_value"
                                   column_invisible="condition_type != 'subtasks_percentage'"
                                   widget="percentage"
                                   optional="hide"/>
                            <field name="action_type"/>
                            <field name="action_stage_id"
                                   column_invisible="action_type not in ('move_stage', 'both')"
                                   options="{'no_create': True}"
                                   optional="show"/>
                            <field name="action_state"
                                   column_invisible="action_type not in ('set_state', 'both')"
                                   optional="show"/>
                            <field name="execution_count" optional="hide"/>
                            <field name="active" widget="boolean_toggle"/>
                        </tree>
                    </field>

                    <div class="alert alert-info mt-3" role="alert">
                        <h5>🤖 How Stage Automation Works:</h5>
                        <ul>
                            <li><strong>Trigger:</strong> When a task enters a specific stage</li>
                            <li><strong>Condition:</strong> Check if requirements are met (e.g., all subtasks done)</li>
                            <li><strong>Action:</strong> Automatically move to another stage or set state</li>
                        </ul>
                        <p class="mb-0"><strong>💡 Tip:</strong> Configure automation rules on project templates. All projects created from that template will inherit these rules automatically!</p>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
