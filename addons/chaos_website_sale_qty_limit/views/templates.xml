<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add data attribute to mark upsell/optional products -->
    <template id="cart_line_qty_limit" inherit_id="website_sale.cart_lines" name="Cart Line Quantity Limit">
        <xpath expr="//div[@name='website_sale_cart_line_quantity']" position="attributes">
            <attribute name="t-att-data-is-upsell" separator=" ">line._is_upsell_line()</attribute>
            <attribute name="t-att-data-max-qty" separator=" ">1 if line._is_upsell_line() else 0</attribute>
        </xpath>
    </template>

    <!-- Disable plus button for upsell products at max quantity -->
    <template id="cart_line_plus_button" inherit_id="website_sale.cart_lines" name="Disable Plus for Upsell">
        <xpath expr="//a[@class='js_add_cart_json d-inline-block float_left btn btn-link border-start-0']" position="attributes">
            <attribute name="t-att-disabled" separator=" ">
                'disabled' if (line._is_upsell_line() and line.product_uom_qty >= 1) else None
            </attribute>
            <attribute name="t-attf-class" separator=" " add="{{
                'opacity-50 pe-none' if (line._is_upsell_line() and line.product_uom_qty >= 1) else ''
            }}"/>
        </xpath>
    </template>
</odoo>
