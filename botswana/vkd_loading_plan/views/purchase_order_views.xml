<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_purchase_order_form_loading_plan" model="ir.ui.view">
        <field name="name">purchase.order.form.loading.plan</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add stat button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_loading_plans" type="object" 
                        class="oe_stat_button" icon="fa-truck">
                    <field name="loading_plan_count" widget="statinfo" string="Loading Plans"/>
                </button>
            </xpath>
            
            <!-- Add Loading Plan page -->
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                <page string="Loading Plans" name="loading_plans">
                    <field name="loading_plan_ids">
                        <list string="Loading Plans">
                            <field name="name"/>
                            <field name="supplier_type"/>
                            <field name="loading_date_time" placeholder="Date" options="{'show_time': false}"/>
                            <field name="state"/>
                            <button name="action_print_loading_plan" string="Print" type="object"
                                    icon="fa-print" class="btn-primary"/>
                        </list>
                    </field>
                </page>
            </xpath>
            
        </field>
    </record>

</odoo>
