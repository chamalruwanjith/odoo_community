<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_loading_plan_puma">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">LOADING PLAN - PUMA ENERGY</h2>
                <br/>
                
                <div class="row mt-4">
                    <div class="col-6">
                        <strong>Reference:</strong> <span t-field="o.name"/><br/>
                        <strong>Purchase Order:</strong> <span t-field="o.purchase_order_id.name"/><br/>
                        <strong>Supplier:</strong> <span t-field="o.partner_id.name"/><br/>
                    </div>
                    <div class="col-6">
                        <strong>Loading Date  &amp; Time:</strong> <span t-field="o.loading_date_time"/><br/>
                        <strong>Status:</strong> <span t-field="o.state"/><br/>
                    </div>
                </div>

                <h4 class="mt-4">Transport Information</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td width="30%"><strong>Transport Company</strong></td>
                        <td width="70%"><span t-field="o.transporter_id"/></td>
                    </tr>
                    <tr>
                        <td><strong>Vehicle/Truck</strong></td>
                        <td><span t-field="o.puma_vehicle_truck"/></td>
                    </tr>
                    <tr>
                        <td><strong>Transporter's Contact Person</strong></td>
                        <td><span t-field="o.puma_transporter_contact"/></td>
                    </tr>
                    <tr>
                        <td><strong>Horse Registration</strong></td>
                        <td><span t-field="o.transporter_vehicle_id"/></td>
                    </tr>
                    <tr>
                        <td><strong>Trailer Registration</strong></td>
                        <td><span t-field="o.trailer_1_id"/></td>
                    </tr>
                    <tr t-if="o.trailer_2_id">
                        <td><strong>Trailer Registration 2</strong></td>
                        <td><span t-field="o.trailer_2_id"/></td>
                    </tr>
                    <tr t-if="o.trailer_3_id">
                        <td><strong>Trailer Registration 3</strong></td>
                        <td><span t-field="o.trailer_3_id"/></td>
                    </tr>
                    <tr>
                        <td><strong>Driver Name</strong></td>
                        <td><span t-field="o.driver_id"/></td>
                    </tr>
                </table>

                <h4 class="mt-4">Vehicle Information</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td width="30%"><strong>Tanker Reg Number</strong></td>
                        <td width="70%"><span t-field="o.puma_tanker_reg_no"/></td>
                    </tr>
                    <tr t-if="o.puma_tanker_reg_no_2">
                        <td><strong>Tanker Reg Number 2</strong></td>
                        <td><span t-field="o.puma_tanker_reg_no_2"/></td>
                    </tr>
                    <tr t-if="o.puma_tanker_reg_no_3">
                        <td><strong>Tanker Reg Number 3</strong></td>
                        <td><span t-field="o.puma_tanker_reg_no_3"/></td>
                    </tr>
                </table>

                <h4 class="mt-4">Order Information</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td width="30%"><strong>NCI's ePuma Order No.</strong></td>
                        <td width="70%"><span t-field="o.puma_epuma_order_no"/></td>
                    </tr>
                    <tr>
                        <td><strong>NCI's ePuma Load Code</strong></td>
                        <td><span t-field="o.puma_epuma_load_code"/></td>
                    </tr>
                    <tr>
                        <td><strong>Contact Person</strong></td>
                        <td><span t-field="o.contact_person"/></td>
                    </tr>
                    <tr>
                        <td><strong>Destination</strong></td>
                        <td><span t-field="o.destination"/></td>
                    </tr>
                    <tr>
                        <td><strong>Order Volumes</strong></td>
                        <td><span t-field="o.puma_order_volumes"/></td>
                    </tr>
                </table>

                <h4 class="mt-4">Product Information</h4>
                <table class="table table-sm table-bordered">
                    <tr>
                        <td width="30%"><strong>Product 50PPM Diesel</strong></td>
                        <td width="70%"><span t-field="o.puma_product_50ppm"/></td>
                    </tr>
                    <tr>
                        <td><strong>Petrol (ULP)</strong></td>
                        <td><span t-field="o.product_id"/> - Qty: <span t-field="o.product_ulp_qty"/></td>
                    </tr>
                    <tr>
                        <td><strong>Diesel (D50)</strong></td>
                        <td><span t-field="o.product_id"/> - Qty: <span t-field="o.product_d50_qty"/></td>
                    </tr>
                </table>

                <h4 class="mt-4">Compartments</h4>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr class="text-center">
                            <th>Comp 1</th>
                            <th>Comp 2</th>
                            <th>Comp 3</th>
                            <th>Comp 4</th>
                            <th>Comp 5</th>
                            <th>Comp 6</th>
                            <th>Comp 7</th>
                            <th>Comp 8</th>
                            <th>Comp 9</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-center">
                            <td><span t-field="o.compartment_1"/></td>
                            <td><span t-field="o.compartment_2"/></td>
                            <td><span t-field="o.compartment_3"/></td>
                            <td><span t-field="o.compartment_4"/></td>
                            <td><span t-field="o.compartment_5"/></td>
                            <td><span t-field="o.compartment_6"/></td>
                            <td><span t-field="o.compartment_7"/></td>
                            <td><span t-field="o.compartment_8"/></td>
                            <td><span t-field="o.compartment_9"/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="text-center">
                            <td colspan="8" class="text-right"><strong>Total:</strong></td>
                            <td><strong><span t-field="o.total_compartments"/></strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>
</odoo>
